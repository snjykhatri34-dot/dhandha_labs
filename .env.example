# Copy to .env.local (Next.js app) or .env (Python pipeline) and fill in. Never commit the real file.

# Data layer for the web app: mock (default, uses the synthetic files in data/) or supabase
DATA_SOURCE=mock
# Mock Stream 1 delay before a canned scorecard lands (ms)
MOCK_ANALYSE_DELAY_MS=3000

# Supabase: Project Settings → API (Sanjay). RLS has no policies, so only the
# service role key can read or write: use it server side only, never in the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline models (Stream 2, pipeline/llm.py)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# WhatsApp push (Ayse)
# twilio (default) or meta (Meta WhatsApp Cloud API, free test number)
WHATSAPP_PROVIDER=twilio
# Meta: WhatsApp → API Setup in developers.facebook.com. The temporary token lasts 24 hours.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
NOTIFY_TRIGGER=report_ready
APP_BASE_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_TO=
# Optional: approved WhatsApp template (HX…) to use instead of free text. {{1}} = summary, {{2}} = report link
TWILIO_CONTENT_SID=
# 1 = log the WhatsApp message instead of sending it
NOTIFY_DRY_RUN=0
