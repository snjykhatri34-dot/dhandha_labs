# Copy to .env.local and fill in. Never commit .env.local.

# Data layer: mock (default, uses the synthetic files in data/) or supabase (after Stream 2 ships)
DATA_SOURCE=mock
# Mock Stream 1 delay before a canned scorecard lands (ms)
MOCK_ANALYSE_DELAY_MS=3000

# Supabase (from Sanjay)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp push (Ayse)
# twilio (default) or meta (Meta WhatsApp Cloud API, free test number)
WHATSAPP_PROVIDER=twilio
# Meta: WhatsApp → API Setup in developers.facebook.com. The temporary token lasts 24 hours.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
NOTIFY_TRIGGER=report_ready
APP_BASE_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_TO=
# Optional: approved WhatsApp template (HX…) to use instead of free text. {{1}} = summary, {{2}} = report link
TWILIO_CONTENT_SID=
# 1 = log the WhatsApp message instead of sending it
NOTIFY_DRY_RUN=0
